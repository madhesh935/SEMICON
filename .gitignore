# Virtual environments and Python/tool caches
.venv/
.venv_submission/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tmp/
